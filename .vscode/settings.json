{
	"cSpell.words": [
		"Bignum",
		"Enummify",
		"stdlib",
		"YJIT"
	],
	"rubyLsp.featureFlags": { "tapiocaAddon": true },
	"rubyLsp.rubyVersionManager": { "identifier": "chruby" },
	"search.exclude": {
		"**/sorbet/rbi": true,
		"pkg": true,
		"tmp": true
	},
	"sorbet.enabled": true,
	"sorbet.lspConfigs": [
		{
			"id": "stable",
			"name": "Sorbet",
			"description": "Stable Sorbet Ruby IDE features",
			"env": { "SRB_SKIP_GEM_RBIS": "1" },
			"command": ["bundle", "exec", "srb", "typecheck", "--lsp"]
		},
		{
			"id": "beta",
			"name": "Sorbet (Beta)",
			"description": "Beta Sorbet Ruby IDE features",
			"env": { "SRB_SKIP_GEM_RBIS": "1" },
			"command": [
				"bundle",
				"exec",
				"srb",
				"typecheck",
				"--lsp",
				"--enable-all-beta-lsp-features"
			]
		},
		{
			"id": "experimental",
			"name": "Sorbet (Experimental)",
			"description": "Experimental Sorbet Ruby IDE features (warning: crashy, for developers only)",
			"env": { "SRB_SKIP_GEM_RBIS": "1" },
			"command": [
				"bundle",
				"exec",
				"srb",
				"typecheck",
				"--lsp",
				"--enable-all-experimental-lsp-features"
			]
		}
	],
	"[ruby]": {
		"editor.formatOnSave": true
	}
}
